# MaternaLink — local development environment.
# Copy to .env (untracked, gitignored) and fill in real values.
# No secret and no fusion parameter belongs in this file (standing rule 3, §7A.7).

# --- backend ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Phase 3.2 — Groq local-only activation (D-6 permits this under
# NODE_ENV=development only). GROQ_API_KEY is added separately by the
# owner directly in this file, never by an agent/assistant.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=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

FER_SERVICE_URL=http://fer:7860
SENTIMENT_SERVICE_URL=http://sentiment:8000
FUSION_SERVICE_URL=http://fusion:9000

# PROVISIONAL — FER end-to-end latency and all sentiment latency are UNKNOWN
# (handoff §7.1, §13). Set for real in C8.3.
FER_TIMEOUT_MS=3000
SENTIMENT_TIMEOUT_MS=15000
FUSION_TIMEOUT_MS=1000

LANGUAGE_POLICY=face_only

# Local Docker Postgres (previous): DATABASE_URL=postgres://maternalink:changeme@postgres:5432/maternalink
DATABASE_URL=postgresql://postgres.kwsysidhjdsyobaosuxe:yasindu%40026@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=no-verify
DATABASE_SCHEMA=chatbot

# C7 — Supabase Anonymous Authentication. This backend is NOT a JWT issuer;
# this is the SUPABASE PROJECT's JWT secret, used only to verify tokens
# Supabase itself issued. Not yet a real Supabase project locally — replace
# with the value from Project Settings -> API -> JWT Secret when configured.
SUPABASE_URL=https://kwsysidhjdsyobaosuxe.supabase.co

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FACE_PER_MIN=300
RATE_LIMIT_TEXT_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=600

MOOD_OBSERVATION_RETENTION_DAYS=30

# --- postgres ---
POSTGRES_USER=maternalink
POSTGRES_PASSWORD=changeme
POSTGRES_DB=maternalink

# --- fer / sentiment / fusion (off in production; off here too by default) ---
FER_DEBUG=0
SENTIMENT_DEBUG=0
FUSION_DEBUG=0

# --- fusion parameters (C4_PLAN.md §3.2) ---
# ⛔ THESE ARE PLACEHOLDERS — NOT MEASUREMENTS, NOT ESTIMATES, NOT PROPOSALS
# TO PHASE 7. They exist only so integration can proceed before the Phase 7
# weight-sensitivity experiment produces real values (C9). This is the
# supervisor-specified development placeholder set (C4_PLAN.md §3.2), stated
# explicitly here rather than invented, per §8.3. Until C9 replaces them, no
# mood output from this system may be presented as a measured result.
#
# W_face deliberately avoids 0.50-0.60: the weight-sensitivity sweep found
# the fused state flips inside that band when the modalities disagree, so a
# placeholder there would produce demo behaviour maximally unrepresentative
# of whatever the measured value turns out to be. 0.35 is not "more
# correct" — no value is correct until Phase 7.
FUSION_W_FACE=0.35
FUSION_W_TEXT=0.65
FUSION_TAU_FACE_MIN=0.30
FUSION_TAU_TEXT_MIN=0.30
FUSION_TAU_FUSION_MIN=0.30
FUSION_TAU_DISTRESS=0.60
FUSION_PARAM_PROVENANCE=PLACEHOLDER FOR TESTING - NOT A MEASURED VALUE
