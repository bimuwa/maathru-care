# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chatbot backend: "live" calls the API below, "mock" uses built-in replies (default)
EXPO_PUBLIC_CHATBOT_API_MODE=mock
EXPO_PUBLIC_CHATBOT_API_BASE_URL=http://localhost:3000

# Optional: camera mood sensing (defaults shown)
# EXPO_PUBLIC_FER_JPEG_QUALITY=90
# EXPO_PUBLIC_FER_SAMPLE_MS=1000
